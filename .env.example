# Copy to .env and edit. Read by hep4m/paths.py; `python -m hep4m.paths` prints the result.
# Only HEP4M_DATA and HEP4M_WORK normally need setting.

# Downloaded data: release/ (Zenodo files), Tokenized_7mod/ (tokenised store),
# Checkpoints/ (tokenisers).
HEP4M_DATA=/path/to/hep-any2any-data

# Writable: runs/, outputs/ (inference and evaluation), checkpoints/ckpt.<row>/ (released models).
HEP4M_WORK=/path/to/hep-any2any-work

# Optional overrides
# HEP4M_RELEASE=${HEP4M_DATA}/release
# HEP4M_RAW_TEST=${HEP4M_RELEASE}/eval.raw_test_singlejet_0_100kseg_bw100.0.root
# HEP4M_TOKENIZED=${HEP4M_DATA}/Tokenized_7mod
# HEP4M_TOKENIZERS=${HEP4M_DATA}/Checkpoints
# HEP4M_CKPT=${HEP4M_WORK}/checkpoints
# HEP4M_RAW_TRAIN=${HEP4M_DATA}/raw_train   (tokeniser retraining only; not in the record)

# Training logger: csv (default, files in the run directory), wandb (needs
# pip install ".[wandb]" and a wandb account) or comet (needs pip install ".[comet]")
HEP4M_LOGGER=csv
